  "reviewNotes": {
    "/summaries/start-with-why/": {
      "text": "Archive correction: Sam Walton died in 1992, rather than 1983. The Southwest co-founder named in the review is Herb Kelleher, rather than Herb Kellerman. The original review is preserved below.",
      "sources": [
        {
          "label": "Walmart: Sam Walton",
          "url": "https://corporate.walmart.com/about/sam-walton"
        },
        {
          "label": "Southwest history",
          "url": "https://www.swamedia.com/news-and-stories/news-release/herb-rollin-the-birth-of-southwest-airlines-MC3ZAGEOPKJ5EA5JKHV4GNRM7UGI"
        }
      ]
    },
    "/summaries/deep-work/": {
      "text": "Archive correction: the cited 2012 McKinsey breakdown is 28% of interaction workers’ time on email, 19% finding information and 14% collaborating internally. Email plus information search is 47%, rather than the review’s 60%. References to the author’s latest book describe the time of writing.",
      "sources": [
        {
          "label": "McKinsey’s 2012 breakdown",
          "url": "https://www.mckinsey.com/mgi/media-center/social-media-productivity-payoff"
        }
      ]
    },
    "/summaries/the-five-dysfunctions-of-a-team/": {
      "text": "Archive correction: the fictional CEO is Kathryn Petersen. The original review uses Katherine Peterson and Karen; these refer to the same character.",
      "sources": [
        {
          "label": "Publisher’s book record",
          "url": "https://www.wiley.com/content/dam/wiley-dotcom/en/b2c/permissions/business---rights/translation/2024%20Smash%20Hits.pdf"
        }
      ]
    },
    "/summaries/5-conversations/": {
      "text": "Archive correction: this book is by Nick Cowley and Nigel Purse. The body’s Nick Crowley is a spelling error. Showing appreciation is conversation three in the review’s own opening list, although a later sentence calls it the second.",
      "sources": [
        {
          "label": "CMI book record",
          "url": "https://www.managers.org.uk/~/media/Angela-Media-Library/pdfs/Books/CMI%20Book%20of%20the%20Year%202016%20DIgital.pdf"
        }
      ]
    },
    "/summaries/thinking-fast-and-slow/": {
      "text": "Archive context: the quoted TED description of a living psychologist is historical. Daniel Kahneman died on 27 March 2024. The article records its contributor’s reading of the book; its discussion of individual experiments is not a new review of the subsequent research.",
      "sources": [
        {
          "label": "Nobel Prize biographical record",
          "url": "https://www.nobelprize.org/prizes/economic-sciences/2002/kahneman/biographical/"
        }
      ]
    },
    "/summaries/crucial-conversations/": {
      "text": "Archive context: the review discusses the earlier edition by Kerry Patterson, Joseph Grenny, Ron McMillan and Al Switzler. The citation printed as page 20w contains an unresolved reference typo; it has not been silently changed to a guessed page.",
      "sources": []
    }
  },
