---
permalink: /authors/rss.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"><channel><title>Actionable Books: Book authors</title><link>https://actionablebooks.com/authors/</link><description>Book authors from the Actionable Books archive.</description>
{% for item in library.groups['authors'] %}<item><title>{{ item.title }}</title><link>https://actionablebooks.com{{ item.url }}</link><guid>https://actionablebooks.com{{ item.url }}</guid>{% if item.published %}<pubDate>{{ item.published | dateRss }}</pubDate>{% endif %}{% if item.excerpt %}<description>{{ item.excerpt }}</description>{% endif %}</item>{% endfor %}</channel></rss>
