---
permalink: /summaries/rss.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0"><channel><title>Actionable Books: Book summaries</title><link>https://actionablebooks.com/summaries/</link><description>Book summaries from the Actionable Books archive.</description>
{% for item in library.groups['summaries'] %}<item><title>{{ item.title }}</title><link>https://actionablebooks.com{{ item.url }}</link><guid>https://actionablebooks.com{{ item.url }}</guid>{% if item.published %}<pubDate>{{ item.published | dateRss }}</pubDate>{% endif %}{% if item.excerpt %}<description>{{ item.excerpt }}</description>{% endif %}</item>{% endfor %}</channel></rss>
