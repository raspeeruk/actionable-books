{% from 'partials/cards.njk' import shelf, pagination %}
{% set entry = page.inputPath | libraryEntry(page.url, title, description) %}
{% set archive = entry.url | directoryFor %}
<div class="container page-content">
{% if entry.url == '/' %}
  <section class="home-intro"><p class="eyebrow">Ideas worth putting to work</p><h1>Find your next<br>useful idea.</h1><p class="lede">Explore {{ library.summaryCount }} free book summaries. Read the big idea, consider a reader’s perspective and find something to try.</p>
    <form action="/search/" method="get" class="search-form" role="search"><label for="home-query">Find a book or author</label><div><input id="home-query" type="search" name="query" placeholder="Book title or author" required><button type="submit">Find a summary</button></div></form>
  </section>
  <section class="shelf-section"><div class="section-heading"><h2>Explore the library</h2><a href="/summaries/">All book summaries →</a></div>{{ shelf(library.featured) }}</section>
  <section class="shelf-section"><h2>Start with a topic</h2><div class="topic-links">{% for topic in library.bookTopics %}<a href="{{ topic.url }}">{{ topic.title }} <span aria-hidden="true">↗</span></a>{% endfor %}</div></section>
  <section class="reading-note"><h2>Choose a place to start</h2><p>Follow a short reading path, with original reviews and a practical question for each book.</p><div class="topic-links"><a href="/lists/best-books-for-new-managers/">Start managing a team →</a><a href="/lists/best-communication-books/">Prepare for a difficult conversation →</a><a href="/guides/best-productivity-books/">Choose and protect useful work →</a></div></section>
  <section class="reading-note"><h2>One book. Different perspectives.</h2><p>Our archive brings together reviews by named contributors. Each reader notices something different. Explore the original writing and decide which ideas are useful to you.</p><a href="/team/">Meet the contributors →</a></section>
{% elif entry.family == 'summaries' %}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/summaries/">Book summaries</a>{% if entry.topic %} / <a href="{{ entry.topic.url }}">{{ entry.topic.title }}</a>{% endif %}</nav>
  <article class="summary-layout">
    <header class="article-intro bookmark"><div><p class="eyebrow">Book summary</p><h1>{{ entry.title }}</h1>
      {% if entry.authorName %}<p class="book-author">By {% if entry.author and not entry.bookAuthorNames %}<a href="{{ entry.author.url }}">{{ entry.authorName }}</a>{% else %}{{ entry.authorName }}{% endif %}</p>{% endif %}
      {% if entry.contributor %}<p class="byline">{% if entry.attributionNote %}Archive credit:{% else %}Summary by{% endif %} <a href="{{ entry.contributor.url }}">{{ entry.data['f_original-contributor-name'] or entry.contributor.title }}</a></p>{% endif %}
      {% if entry.attributionNote %}<p class="small">{{ entry.attributionNote }}</p>{% endif %}
      <p class="small">An original reader’s perspective from the Actionable Books archive.</p>
    </div>{% if entry.image %}<img class="intro-cover" src="{{ entry.image }}" width="132" height="180" alt="{{ entry.imageAlt }}" fetchpriority="high">{% endif %}</header>
    {% if entry.headings.length > 1 %}<nav class="contents" aria-label="In this summary"><strong>In this summary</strong>{% for heading in entry.headings %}<a href="#{{ heading.id }}">{{ heading.title }}</a>{% endfor %}</nav>{% endif %}
    {% if entry.limitedArchive %}<aside class="archive-notice"><p>Only the original introduction survives in the available archive. We have retained that writing without inventing missing insights or a conclusion.</p></aside>{% endif %}
    {% if entry.correction %}<aside class="archive-notice"><h2>Reading context</h2><p>{{ entry.correction.text }}</p>{% for source in entry.correction.sources %}<a href="{{ source.url }}">{{ source.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</aside>{% endif %}
    <div class="prose original-review">{{ entry.html | safe }}</div>
    {% if entry.purchaseUrl %}<aside class="purchase-note"><h2>Read the full book</h2><p>The summary is one reader’s interpretation. The book gives you the complete argument and context.</p><p class="small">As an Amazon Associate we earn from qualifying purchases.</p><a href="{{ entry.purchaseUrl }}" rel="sponsored noopener" data-affiliate="amazon" data-book="{{ entry.slug }}">Find the book on Amazon →</a></aside>{% endif %}
  </article>
  {% if entry.related.length %}<section class="shelf-section"><div class="section-heading"><h2>More in {{ entry.topic.title }}</h2><a href="{{ entry.topic.url }}">Explore this topic →</a></div>{{ shelf(entry.related) }}</section>{% endif %}
{% elif archive %}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{% if entry.family == 'authors' %} / <a href="/authors/">Book authors</a>{% elif entry.family == 'team' %} / <a href="/team/">Contributors</a>{% endif %}</nav>
  <header class="archive-intro bookmark"><div><p class="eyebrow">{% if entry.family == 'authors' %}Book author{% elif entry.family == 'team' %}Contributor{% else %}Explore the archive{% endif %}</p><h1>{{ entry.title }}</h1><p class="lede">{{ archive.description }}</p></div>{% if entry.image %}<img class="profile-image" src="{{ entry.image }}" width="128" height="150" alt="{{ entry.imageAlt }}">{% endif %}</header>
  {% if entry.html %}<div class="prose profile-bio">{{ entry.html | safe }}</div>{% if entry.family == 'authors' or entry.family == 'team' %}<p class="small">Biography retained from the original archive; roles and links may be historical.</p>{% endif %}{% endif %}
  <section class="shelf-section"><h2>{% if entry.family == 'authors' %}Books in the archive{% elif entry.family == 'team' %}Contributions{% elif entry.family == 'summary-categories' %}Browse {{ archive.total }} book summaries{% else %}Browse {{ archive.total }} entries{% endif %}</h2>{{ shelf(archive.items) }}{{ pagination(archive) }}</section>
{% elif entry.family == 'blog' %}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog/">Articles</a>{% if entry.topic %} / <a href="{{ entry.topic.url }}">{{ entry.topic.title }}</a>{% endif %}</nav>
  <article class="reading-column"><header class="article-intro bookmark"><div><p class="eyebrow">From the archive</p><h1>{{ entry.title }}</h1>{% if entry.contributor %}<p class="byline">By <a href="{{ entry.contributor.url }}">{{ entry.contributor.title }}</a></p>{% endif %}{% if entry.published %}<time datetime="{{ entry.published }}">{{ entry.published | dateDisplay }}</time>{% endif %}</div></header>{% if entry.body %}<div class="prose">{{ entry.html | safe }}</div>{% else %}<aside class="archive-notice"><p>The article text is not available in the preserved archive. This historical record retains its title and date. Explore the <a href="/blog/">other articles</a> or <a href="/contact/">contact Actionable</a> with an original copy.</p></aside>{% endif %}</article>
{% elif entry.family == 'lists' %}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/lists/">Reading lists</a></nav><div class="reading-column"><h1>{{ entry.title }}</h1>{% if entry.journey %}{% include 'partials/journey.njk' %}{% else %}<aside class="archive-notice"><p>This later, AI-labelled reading list is under editorial review. Follow the original summaries below to assess each book. The selection is separate from the named contributors’ original reviews.</p></aside><ol class="reading-list">{% for item in entry.data.f_items %}{% set book = item.item_summary_ref | libraryEntry %}<li><h2><a href="{{ book.url }}">{{ book.title }}</a></h2><p>{{ book.authorName }}</p><p>{{ book.excerpt }}</p><a href="{{ book.url }}">Read the original summary →</a></li>{% endfor %}</ol>{% endif %}</div>
{% elif entry.family == 'guides' %}
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{% if entry.url != '/guides/' %} / <a href="/guides/">Reading guides</a>{% endif %}</nav><article class="reading-column"><header class="article-intro bookmark"><div><p class="eyebrow">Reading guide</p><h1>{{ entry.title }}</h1></div></header><p class="small">These later guides have received AI-assisted factual and source checks. They are separate from the handwritten contributor reviews and do not claim a firsthand reading by every contributor.</p>{% if entry.journey %}{% include 'partials/journey.njk' %}<h2>More approaches to explore</h2>{% endif %}<div class="prose">{{ entry.html | safe }}</div>{% if entry.guideResources.length %}<section class="shelf-section"><h2>Original reviews in this archive</h2><p>Explore these relevant preserved reviews. Check the author as well as the title.</p>{{ shelf(entry.guideResources) }}</section>{% endif %}</article>
{% elif entry.url == '/topics/' %}
  <h1>Explore book summaries by topic</h1><p class="lede">Start with the area you want to think about, then explore a contributor’s perspective on a book.</p><div class="topic-links">{% for topic in library.bookTopics %}<a href="{{ topic.url }}">{{ topic.title }} →</a>{% endfor %}</div><h2>Article topics</h2><div class="topic-links">{% for topic in library.articleTopics %}<a href="{{ topic.url }}">{{ topic.title }} →</a>{% endfor %}</div>
{% elif entry.url == '/search/' %}
  <h1>Find a book or author</h1><form action="/search/" method="get" class="search-form" role="search"><label for="search-query">Search the summary library</label><div><input id="search-query" type="search" name="query" required><button type="submit">Search</button></div></form><p id="search-status" role="status">Search by book title or author. You can also <a href="/summaries/">browse every summary</a> or <a href="/topics/">explore topics</a>.</p><div id="search-results"></div><noscript><p>Search needs JavaScript. The complete <a href="/summaries/">linked summary archive</a> works without it.</p></noscript>
{% elif entry.url == '/about/' %}
  <article class="reading-column"><h1>About Actionable Books</h1><div class="prose"><p>Actionable Books is a free archive of book summaries, practical insights and author interviews. The original summaries reflect the perspectives of their named contributors, rather than a substitute for reading the whole book.</p><p>Chris Taylor founded Actionable in 2008. Actionable Books is operated by Actionable.co Canada Inc.</p><h2>How to use the archive</h2><p>Find a book, explore its big idea and consider an insight you could put into practice. Each summary distinguishes the book’s author from the contributor who wrote about it. Where different contributors reviewed the same book, we retain their separate perspectives.</p><h2>The writing and its history</h2><p>The original summaries are preserved from the historical Actionable Books archive. Biographies, roles and contemporary references may describe the time of writing. Technical restoration does not give an old article a new publication date.</p><p>Some later reading-list pages are being reviewed separately. They are not presented as part of the original contributor-written collection.</p><h2>Corrections and commercial links</h2><p>Found an attribution, quotation or link that needs attention? <a href="/contact/">Contact Actionable</a>. Some book purchase links are affiliate links; a qualifying purchase can earn a commission. This does not change the contributor’s original review.</p><p><a href="/team/">Explore the contributors</a> or <a href="https://actionable.co/about/">read about Actionable today</a>.</p></div></article>
{% elif entry.url == '/contact/' %}
  <article class="reading-column"><h1>Contact Actionable Books</h1><div class="prose"><p>For questions about Actionable Books, corrections to the archive or enquiries for Actionable, email <a href="mailto:hello@actionable.co">hello@actionable.co</a>.</p><p>For an archive correction, include the page URL and the detail you think needs changing. Original book authors and summary contributors are credited separately.</p><h2>Privacy questions</h2><p>Email <a href="mailto:privacy@actionable.co">privacy@actionable.co</a> or read the <a href="/privacy-policy/">privacy information</a>.</p><p>Operated by Actionable.co Canada Inc. <a href="https://actionable.co/about/">Actionable’s current contact details</a>.</p></div></article>
{% elif entry.url == '/privacy-policy/' %}
  <article class="reading-column"><h1>Privacy at Actionable Books</h1><div class="prose"><p>Actionable Books is operated by Actionable.co Canada Inc. For the company’s privacy policy, visit <a href="https://actionable.co/trust/privacy/">Actionable’s privacy policy</a>. Questions about personal information can be sent to <a href="mailto:privacy@actionable.co">privacy@actionable.co</a>.</p><h2>Your visit to this website</h2><p>The website is hosted by Netlify, which processes requests to deliver its pages and assets. A privacy choice is saved in your browser’s local storage so the site can remember it.</p><h2>Optional analytics</h2><p>If you allow analytics, Google Analytics receives information about page visits and interactions, including summary and purchase-link clicks. The site does not send form text, email addresses or search phrases as analytics events. We configure Analytics with Google Signals and advertising personalisation disabled.</p><p>Rejecting optional analytics keeps the Google Analytics script unloaded. You can change your choice using Cookie settings in the footer. Withdrawal reloads the page to stop previously loaded analytics.</p><h2>Newsletter and other websites</h2><p>New newsletter subscriptions are paused. The site does not load a subscription form, MailerLite or Google reCAPTCHA. For questions about an existing subscription, <a href="/contact/">contact Actionable</a>.</p><p>Book purchase links lead to external retailers. They may contain an affiliate identifier that attributes a qualifying sale. The retailer’s privacy policy and choices apply on its website.</p><h2>Advertising</h2><p>No display-ad network is activated in this site release. Advertising privacy information and choices will be updated if a network is introduced.</p><p>Read <a href="https://actionable.co/trust/">Actionable’s trust centre</a> for wider company privacy and security information.</p></div></article>
{% elif entry.url == '/subscribe/' %}
  <article class="reading-column"><h1>The Actionable Books newsletter</h1><div class="prose"><p>New newsletter subscriptions are paused.</p><p>You can still explore the original reviews and find an idea to put to work.</p><p><a href="/summaries/">Browse the book summaries</a> or <a href="/topics/">choose a topic</a>.</p><p>For questions about an existing subscription, <a href="/contact/">contact Actionable</a>.</p></div></article>
{% elif entry.url == '/404.html' %}
  <div class="reading-column"><p class="eyebrow">Page not found</p><h1>Let’s find the right book.</h1><p>The page you requested is unavailable. Try the <a href="/search/">library search</a>, <a href="/summaries/">all summaries</a> or <a href="/topics/">book topics</a>.</p></div>
{% else %}
  <article class="reading-column"><h1>{{ entry.title }}</h1>{% if entry.html %}<div class="prose">{{ entry.html | safe }}</div>{% else %}<p>Explore the <a href="/summaries/">book summary archive</a> or <a href="/contact/">contact Actionable</a> about this historical page.</p>{% endif %}</article>
{% endif %}
</div>
