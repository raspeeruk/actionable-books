{% set entry = page.inputPath | libraryEntry(page.url, title, description) %}
{% set metaTitle = entry.metaTitle %}{% set metaDescription = entry.description %}
{% if directory %}{% set metaTitle = directory.title + ' | Actionable Books' %}{% set metaDescription = directory.description %}{% endif %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ metaTitle }}</title>
  <meta name="description" content="{{ metaDescription }}">
  <link rel="canonical" href="https://actionablebooks.com{{ entry.aliasOf or page.url }}">
  {% if entry.noindex or directory.noindex %}<meta name="robots" content="noindex,follow">{% endif %}
  <meta property="og:title" content="{{ metaTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="https://actionablebooks.com{{ page.url }}">
  <meta property="og:type" content="{% if entry.family == 'summaries' or entry.family == 'blog' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="Actionable Books">
  <meta property="og:image" content="https://actionablebooks.com/assets/images/actionable-books-team-p-1080.webp">
  <meta property="og:image:width" content="1080"><meta property="og:image:height" content="720">
  <meta property="og:image:alt" content="Actionable team photograph from the archive">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="google-site-verification" content="Fp7hIuy11CPQtpYEojBnAJU6F94T3xwmL2HoUVt4Q7s">
  <meta name="google-adsense-account" content="ca-pub-3649517228913627">
  <link rel="icon" href="/assets/images/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/images/webclip.png">
  <link rel="preload" href="/assets/fonts/commissioner-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/alegreya-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/library.css">
  <script type="application/ld+json">{{ entry | entrySchema(directory) | jsonLd | safe }}</script>
  <script src="/assets/js/library.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="/" class="brand"><img src="/assets/images/actionable-books-logo-rgb.svg" width="102" height="60" alt="Actionable Books"></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
      <nav id="site-navigation" aria-label="Main navigation">
        <a href="/summaries/">Book summaries</a><a href="/topics/">Topics</a><a href="/guides/">Reading guides</a><a href="/about/">About</a><a href="/search/" class="search-link">Search <span aria-hidden="true">↗</span></a>
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="container footer-inner"><div><strong>Actionable Books</strong><p>Read an idea. Put it to work.</p></div>
      <nav aria-label="Footer"><a href="/summaries/">All summaries</a><a href="/authors/">Book authors</a><a href="/team/">Contributors</a><a href="/blog/">Articles</a><a href="/lists/">Reading lists</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy</a><a href="/site-map/">Website directory</a><button type="button" data-cookie-settings>Cookie settings</button></nav>
      <p class="small">Actionable Books is operated by Actionable.co Canada Inc. <a href="https://actionable.co/">Visit Actionable</a>.</p>
    </div>
  </footer>
  <section class="cookie-panel" id="cookie-panel" role="region" aria-labelledby="cookie-title" hidden>
    <h2 id="cookie-title">Your privacy choices</h2><p>Optional Google Analytics helps us understand which reading pages are useful. Choose whether to allow it. Your choice is saved on this device. <a href="/privacy-policy/">Privacy details</a>.</p>
    <div class="button-row"><button type="button" data-consent="denied">Reject optional analytics</button><button type="button" data-consent="granted">Allow analytics</button></div>
  </section>
</body>
</html>
